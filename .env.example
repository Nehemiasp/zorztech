# Base de datos (PostgreSQL: Neon o Supabase)
DATABASE_URL=

# Auth.js
AUTH_SECRET=

# URL pública del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagos: "mock" hasta que exista la pasarela real (ver docs/conectar-pasarela.md)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=            # cuando exista
PAYMENT_API_SECRET=         # cuando exista
PAYMENT_WEBHOOK_SECRET=     # cuando exista

# Correo transaccional (Resend)
RESEND_API_KEY=

# Imágenes (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Protege las rutas de cron (expiración de reservas)
CRON_SECRET=

# Remitente de los correos (dominio verificado en Resend)
EMAIL_FROM=

# Google (opcional): si se completan, aparece "Continuar con Google"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Solo desarrollo: crea un administrador al correr el seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Solo pruebas e2e: desactiva los límites de peticiones. NUNCA en producción.
RATE_LIMIT_OFF=

# Solo pruebas e2e contra `npm start`: permite guardar imágenes en disco sin Vercel Blob. NUNCA en producción.
ALLOW_LOCAL_UPLOADS=
