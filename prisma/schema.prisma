// Esquema de datos de ZorzTech (sección 7 del brief).
// Dinero: siempre enteros en centavos de quetzal (Q 1,299.00 = 129900).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  cliente
  admin
}

enum OrderStatus {
  pendiente_pago
  pago_fallido
  expirado
  pagado
  en_preparacion
  enviado
  listo_para_recoger
  entregado
  cancelado
  reembolsado
}

enum PaymentStatus {
  pending
  approved
  declined
  cancelled
  refunded
  error
}

enum ShippingMethod {
  domicilio
  recogida
}

enum CouponType {
  porcentaje
  monto
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String?
  name         String
  phone        String?
  role         Role                 @default(cliente)
  // Límite de intentos: tras varios fallos seguidos la cuenta se bloquea unos minutos.
  failedLogins Int                  @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  resetTokens  PasswordResetToken[]
  addresses    Address[]
  carts        Cart[]
  orders       Order[]

  @@map("users")
}

// Solo se guarda el hash del enlace de recuperación; el enlace en sí viaja por correo.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre           String
  telefono         String
  departamento     String
  municipio        String
  direccion        String
  referencia       String?
  esPredeterminada Boolean @default(false)

  @@index([userId])
  @@map("addresses")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  image    String?
  order    Int        @default(0)
  isActive Boolean    @default(true)
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]

  @@map("brands")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  brandId     String?
  brand       Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  description String           @default("")
  // Especificaciones como pares clave–valor: [{ "clave": "Batería", "valor": "..." }]
  specs       Json             @default("[]")
  isActive    Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  // Producto de ejemplo del seed; el panel lo marca y se muestra como tal en la tienda.
  isSample    Boolean          @default(false)
  // Texto normalizado (sin tildes) en el que busca la tienda. Se recalcula con buildSearchText (lib/search.ts).
  searchText  String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([categoryId, isActive])
  @@index([isActive, isFeatured])
  @@map("products")
}

model ProductVariant {
  id                String         @id @default(cuid())
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String         @unique
  name              String
  // Atributos de la variante: { "color": "Negro", "capacidad": "128 GB" }
  attributes        Json           @default("{}")
  price             Int
  compareAtPrice    Int?
  stock             Int            @default(0)
  reservedStock     Int            @default(0)
  // Umbral de la alerta de stock bajo (panel) y de "Últimas unidades" (tienda).
  lowStockThreshold Int            @default(3)
  isActive          Boolean        @default(true)
  images            ProductImage[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String
  order     Int             @default(0)

  @@index([productId, order])
  @@map("product_images")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id         String         @id @default(cuid())
  cartId     String
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int
  // Precio que el cliente vio al agregar: si cambia, se le avisa antes de pagar.
  priceAtAdd Int

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id                   String          @id @default(cuid())
  // Código legible que ve el cliente (ej. ZT-4K7P2Q).
  code                 String          @unique
  customerName         String
  // Carrito del que salió el pedido; se vacía cuando el pago se aprueba.
  cartId               String?
  // Clave que genera el navegador por intento de compra: repetir la petición no crea otro pedido.
  idempotencyKey       String?         @unique
  userId               String?
  user                 User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                String
  phone                String
  status               OrderStatus     @default(pendiente_pago)
  paymentStatus        PaymentStatus   @default(pending)
  subtotal             Int
  shippingCost         Int
  discount             Int             @default(0)
  total                Int
  shippingMethod       ShippingMethod
  shippingAddress      Json?
  pickupLocationId     String?
  pickupLocation       PickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  // NIT o "CF", y nombre para la factura (la factura electrónica queda fuera de alcance).
  taxId                String
  taxName              String
  notes                String?
  couponId             String?
  coupon               Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  // Hasta cuándo está reservado el stock de un pedido pendiente_pago.
  reservationExpiresAt DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  paidAt               DateTime?
  items                OrderItem[]
  payments             Payment[]
  events               OrderEvent[]

  @@index([userId])
  @@index([cartId])
  @@index([email])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
  @@map("orders")
}

// Copia del producto al momento de comprar: un cambio posterior del catálogo no altera pedidos pasados.
model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  variantName String
  sku         String
  unitPrice   Int
  quantity    Int

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String
  providerRef    String
  status         PaymentStatus @default(pending)
  amount         Int
  currency       String        @default("GTQ")
  // Evita cobros duplicados: un intento de pago por clave.
  idempotencyKey String        @unique
  rawResponse    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payments")
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

model ShippingRate {
  id            String @id @default(cuid())
  departamento  String @unique
  price         Int
  estimatedDays Int

  @@map("shipping_rates")
}

model PickupLocation {
  id       String  @id @default(cuid())
  name     String
  address  String
  hours    String
  isActive Boolean @default(true)
  orders   Order[]

  @@map("pickup_locations")
}

// Fase 4.
model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int
  minSubtotal Int        @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int        @default(0)
  orders      Order[]

  @@map("coupons")
}
